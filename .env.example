# Platform infrastructure secrets only. User source/destination settings and
# affiliate credentials are saved through dashboard into PostgreSQL.
TELEGRAM_BOT_TOKEN=

# Optional shared AI parser credentials. Regex parsing remains fallback.
OPENROUTER_API_KEY=
OPENROUTER_CACHE_ENABLED=true
OPENROUTER_CACHE_TTL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Shared platform Telegram reader. Only operators authenticate this account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_PHONE=
QR_AUTH_PORT=8081
# Local backend/worker access; Docker uses the internal db hostname instead.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5434/offers_db
# Required for backend/worker; generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a secure backup separate from the database. Never expose to frontend.
CREDENTIALS_ENCRYPTION_KEY=
# Rotation only: comma-separated previous Fernet keys, newest first.
CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS=
POSTGRES_DB=offers_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5434
# External PostgreSQL deploy only (docker-compose.coolify.yml).
# Set DATABASE_URL and AUTH_DATABASE_URL to the same external database.
# Docker network already attached to that PostgreSQL resource.
DATABASE_NETWORK=
REDIS_URL=redis://localhost:6379/0
PROMOTION_TTL_SECONDS=600
POSTING_CONCURRENCY=2
# WAHA WhatsApp server; only backend/worker/posting receive the operator API key.
# Join WAHA to DATABASE_NETWORK on Coolify so http://waha:3000 resolves internally.
WAHA_BASE_URL=
WAHA_API_KEY=
# Standalone legacy bot and SQLite import source only.
DATABASE_PATH=data/offers.sqlite3

# Better Auth. Generate the secret with: openssl rand -base64 32
API_BASE_URL=http://backend:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Temporary signup gate (email and Google). Set false and restart to reopen.
DISABLE_PUBLIC_REGISTRATION=true
AUTH_DATABASE_URL=postgresql://postgres:password@localhost:5434/offers_db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password recovery email, sent by the Next.js server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENVIRONMENT=development
