# Platform infrastructure secrets only. User source/destination settings and
# affiliate credentials are saved through dashboard into PostgreSQL.
TELEGRAM_BOT_TOKEN=

# Optional shared AI parser credentials. Regex parsing remains fallback.
OPENROUTER_API_KEY=
OPENROUTER_CACHE_ENABLED=true
OPENROUTER_CACHE_TTL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Shared platform Telegram reader. Only operators authenticate this account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_PHONE=
QR_AUTH_PORT=8081
# Local backend/worker access; Docker uses the internal db hostname instead.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5434/offers_db
POSTGRES_DB=offers_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5434
REDIS_URL=redis://localhost:6379/0
PROMOTION_TTL_SECONDS=180
POSTING_CONCURRENCY=2
# Standalone legacy bot and SQLite import source only.
DATABASE_PATH=data/offers.sqlite3

# Frontend auth. Generate secrets with: openssl rand -base64 32
API_BASE_URL=http://backend:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared secret used only by Next.js server routes for trusted session exchange.
NEXTAUTH_BACKEND_SECRET=
# FastAPI production mode requires JWT_SECRET_KEY.
JWT_SECRET_KEY=
ENVIRONMENT=development
