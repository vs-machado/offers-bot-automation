TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=offers_bot

# Comma-separated source chats. Use public @names, numeric ids, or invite links
# after account has joined them.
SOURCE_CHATS=https://t.me/sourceurl

# Target chat. Prefer numeric id or @name. Private invite links only work if
# Telethon can resolve/join them with your user account.
TARGET_CHAT=https://t.me/yoururl

ML_AFFILIATE_TAG=
ML_COOKIE_HEADER=
ML_CSRF_TOKEN=

SHOPEE_COOKIE_HEADER=
SHOPEE_CSRF_TOKEN=
SHOPEE_AF_AC_ENC_DAT=
SHOPEE_AF_AC_ENC_SZ_TOKEN=
SHOPEE_X_SAP_RI=
SHOPEE_X_SAP_SEC=

AMAZON_AFFILIATE_TAG=
AMAZON_COOKIE_HEADER=
AMAZON_MARKETPLACE_ID=

POLL_EXISTING_MESSAGES=false
DATABASE_PATH=data/offers.sqlite3

# Opens affiliate/profile pages in Chromium to find "Ir para produto" product URLs.
BROWSER_RESOLVER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_DEBUG_DIR=data/browser-debug
